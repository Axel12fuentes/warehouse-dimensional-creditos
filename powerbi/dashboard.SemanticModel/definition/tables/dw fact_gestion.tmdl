		formatString: #,##0
		displayFolder: 01 Volumen
		lineageTag: cefc935d-7a83-4bee-898e-98828c0d4305

	measure 'Cierres' = SUM('dw fact_gestion'[es_desembolso])
		formatString: #,##0
