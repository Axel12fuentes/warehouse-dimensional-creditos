		formatString: #,##0
		displayFolder: 01 Volumen
		lineageTag: dc6526d9-a8ad-4972-93ab-7a6b8ca0f2ed

	measure 'Leads trabajados' = DISTINCTCOUNT('dw fact_gestion'[sk_cliente])
		formatString: #,##0
		displayFolder: 01 Volumen
		lineageTag: a88959a0-1c82-462e-8cb3-61c86181c7dc

	measure 'Tasa de cierre' = DIVIDE([Cierres], [Total gestiones])
		formatString: 0.0%
		displayFolder: 02 Efectividad
		lineageTag: b2d59c98-e42c-4eb1-b29a-7fc983ee4397

	measure 'Contactabilidad' = DIVIDE([Contactos efectivos], [Total gestiones])
		formatString: 0.0%
		displayFolder: 02 Efectividad
		lineageTag: 2f84d162-d85d-46df-ad43-839e233eec1a

	measure 'Tasa de rechazo' = DIVIDE([Rechazos], [Contactos efectivos])
		formatString: 0.0%
		displayFolder: 02 Efectividad
		lineageTag: 2d59549b-7cca-448c-adab-9d7a5dbf282d

	measure 'Gestiones por cierre' = DIVIDE([Total gestiones], [Cierres])
		formatString: #,##0.0
		displayFolder: 02 Efectividad
		lineageTag: d9c2b099-7727-480a-a9f1-b419e922c90a

	measure 'Duracion promedio min' = DIVIDE(AVERAGE('dw fact_gestion'[duracion_seg]), 60)
		formatString: #,##0.0
		displayFolder: 02 Efectividad
		lineageTag: 966c65d5-ef5c-42bf-812e-424bf833be08

	partition 'dw fact_gestion' = m
