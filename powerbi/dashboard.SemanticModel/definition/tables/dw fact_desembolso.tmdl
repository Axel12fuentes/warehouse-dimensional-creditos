	measure 'Total desembolsos' = SUM('dw fact_desembolso'[desembolsos])
		formatString: #,##0
		displayFolder: 03 Colocacion
		lineageTag: badb489b-59e5-4e34-9655-e30103a375f0

	measure 'Monto colocado' = SUM('dw fact_desembolso'[monto_pen])
		formatString: "S/ "#,##0
		displayFolder: 03 Colocacion
		lineageTag: cc7b1b33-2031-46e6-b559-db8fcbfab7fb

	measure 'Monto aprobado' = SUM('dw fact_desembolso'[monto_aprobado])
		formatString: "S/ "#,##0
		displayFolder: 03 Colocacion
		lineageTag: 9d6bc2fb-2810-4267-b8f1-a605abfcbb84

	measure 'Ticket promedio' = DIVIDE([Monto colocado], [Total desembolsos])
		formatString: "S/ "#,##0
		displayFolder: 03 Colocacion
		lineageTag: c3ce79f9-fc79-4c5a-9172-51764935602e

	measure 'Tasa de utilizacion' = DIVIDE([Monto colocado], [Monto aprobado])
		formatString: 0.0%
		displayFolder: 03 Colocacion
		lineageTag: b7bafada-e190-41d4-8a44-d06630c760f5

	measure 'Plazo promedio meses' = AVERAGE('dw fact_desembolso'[plazo_meses])
		formatString: #,##0.0
		displayFolder: 03 Colocacion
		lineageTag: c5ee8696-e614-4779-8048-be8b1ccf1489

	measure 'Monto colocado YTD' = TOTALYTD([Monto colocado], 'dw dim_tiempo'[fecha])
		formatString: "S/ "#,##0
		displayFolder: 04 Tiempo
		lineageTag: 9f413613-82c5-4a61-b8e4-56ffb0fb9d75

	measure 'Monto mes anterior' = CALCULATE([Monto colocado], DATEADD('dw dim_tiempo'[fecha], -1, MONTH))
		formatString: "S/ "#,##0
		displayFolder: 04 Tiempo
		lineageTag: 6d50f11b-46d6-4e63-895c-79f7244aa05b

	measure 'Variacion vs mes anterior' = DIVIDE([Monto colocado] - [Monto mes anterior], [Monto mes anterior])
		formatString: 0.0%
		displayFolder: 04 Tiempo
		lineageTag: f5c1bbda-f1c8-488e-99c2-33709faa0c92

	partition 'dw fact_desembolso' = m
		mode: import
		source =
				let
